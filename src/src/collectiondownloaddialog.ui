<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>CollectionDownloadDialog</class>
 <widget class="QDialog" name="CollectionDownloadDialog">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1000</width>
    <height>680</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Download Collection</string>
  </property>
  <layout class="QVBoxLayout" name="outerLayout">
   <!-- Step indicator -->
   <item>
    <widget class="QLabel" name="stepLabel">
     <property name="text">
      <string>Step 1 of 4 — Browse Collections</string>
     </property>
     <property name="styleSheet">
      <string>font-weight: bold; font-size: 13px; margin-bottom: 4px;</string>
     </property>
    </widget>
   </item>
   <!-- Page stack -->
   <item>
    <widget class="QStackedWidget" name="pages">

     <!-- ── Page 0: Browse / Gallery ─────────────────────────────────── -->
     <widget class="QWidget" name="pageBrowse">
      <layout class="QVBoxLayout" name="browseLayout">
       <!-- Top toolbar: game filter + sort + search -->
       <item>
        <widget class="QWidget" name="browseToolbar" native="true">
         <layout class="QHBoxLayout" name="browseToolbarLayout">
          <property name="leftMargin"><number>0</number></property>
          <property name="rightMargin"><number>0</number></property>
          <property name="topMargin"><number>0</number></property>
          <property name="bottomMargin"><number>0</number></property>
          <item>
           <widget class="QLabel">
            <property name="text"><string>Game:</string></property>
           </widget>
          </item>
          <item>
           <widget class="QComboBox" name="gameFilter">
            <property name="minimumWidth"><number>200</number></property>
           </widget>
          </item>
          <item>
           <widget class="QCheckBox" name="showAllGames">
            <property name="text"><string>Show all games</string></property>
            <property name="toolTip"><string>Include collections for games not installed on this system.</string></property>
           </widget>
          </item>
          <item>
           <widget class="QCheckBox" name="adultContentCheck">
            <property name="text"><string>Adult content</string></property>
            <property name="toolTip"><string>Show collections marked as adult content.</string></property>
           </widget>
          </item>
          <item>
           <widget class="QLabel">
            <property name="text"><string>Sort:</string></property>
           </widget>
          </item>
          <item>
           <widget class="QComboBox" name="sortCombo">
            <item><property name="text"><string>Most endorsed</string></property></item>
            <item><property name="text"><string>Most downloaded</string></property></item>
            <item><property name="text"><string>Most recent</string></property></item>
           </widget>
          </item>
          <item>
           <widget class="QLineEdit" name="searchBox">
            <property name="placeholderText"><string>Search collections…</string></property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="refreshButton">
            <property name="text"><string>Refresh</string></property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <!-- Collection list -->
       <item>
        <widget class="QSplitter" name="browseSplitter">
         <property name="orientation"><enum>Qt::Horizontal</enum></property>
         <property name="childrenCollapsible"><bool>false</bool></property>
         <!-- Left: collection list -->
         <widget class="QWidget" name="listPane" native="true">
          <layout class="QVBoxLayout" name="listPaneLayout">
           <property name="leftMargin"><number>0</number></property>
           <property name="rightMargin"><number>0</number></property>
           <property name="topMargin"><number>0</number></property>
           <property name="bottomMargin"><number>0</number></property>
           <item>
            <widget class="QListWidget" name="collectionList">
             <property name="alternatingRowColors"><bool>false</bool></property>
            </widget>
           </item>
           <item>
            <widget class="QLabel" name="collectionCount">
             <property name="text"><string>0 collections</string></property>
            </widget>
           </item>
           <item>
            <widget class="QPushButton" name="loadMoreButton">
             <property name="text"><string>Load more…</string></property>
             <property name="visible"><bool>false</bool></property>
            </widget>
           </item>
          </layout>
         </widget>
         <!-- Right: detail pane -->
         <widget class="QWidget" name="detailPane" native="true">
          <layout class="QVBoxLayout" name="detailPaneLayout">
           <property name="leftMargin"><number>8</number></property>
           <property name="topMargin"><number>0</number></property>
           <property name="rightMargin"><number>0</number></property>
           <property name="bottomMargin"><number>0</number></property>
           <item>
            <widget class="QLabel" name="detailName">
             <property name="text"><string></string></property>
             <property name="styleSheet"><string>font-weight: bold; font-size: 14px;</string></property>
             <property name="wordWrap"><bool>true</bool></property>
            </widget>
           </item>
           <item>
            <widget class="QLabel" name="detailMeta">
             <property name="text"><string></string></property>
             <property name="wordWrap"><bool>true</bool></property>
            </widget>
           </item>
           <item>
            <widget class="QLabel" name="detailSummary">
             <property name="text"><string></string></property>
             <property name="wordWrap"><bool>true</bool></property>
             <property name="alignment">
              <set>Qt::AlignTop|Qt::AlignLeft</set>
             </property>
            </widget>
           </item>
           <item>
            <spacer>
             <property name="orientation"><enum>Qt::Vertical</enum></property>
             <property name="sizeHint" stdset="0">
              <size><width>20</width><height>40</height></size>
             </property>
            </spacer>
           </item>
           <!-- If the game is not detected: game path picker -->
           <item>
            <widget class="QWidget" name="undetectedGameWidget" native="true">
             <property name="visible"><bool>false</bool></property>
             <layout class="QVBoxLayout" name="ugwLayout">
              <property name="leftMargin"><number>0</number></property>
              <property name="topMargin"><number>0</number></property>
              <property name="rightMargin"><number>0</number></property>
              <property name="bottomMargin"><number>0</number></property>
              <item>
               <widget class="QLabel">
                <property name="text"><string>This game was not detected automatically. Browse to its installation folder:</string></property>
                <property name="wordWrap"><bool>true</bool></property>
               </widget>
              </item>
              <item>
               <widget class="QWidget" native="true">
                <layout class="QHBoxLayout" name="gamePathRow">
                 <property name="leftMargin"><number>0</number></property>
                 <property name="topMargin"><number>0</number></property>
                 <property name="rightMargin"><number>0</number></property>
                 <property name="bottomMargin"><number>0</number></property>
                 <item>
                  <widget class="QLineEdit" name="gamePathEdit">
                   <property name="placeholderText"><string>Game installation path…</string></property>
                  </widget>
                 </item>
                 <item>
                  <widget class="QPushButton" name="browseGamePath">
                   <property name="text"><string>Browse…</string></property>
                  </widget>
                 </item>
                </layout>
               </widget>
              </item>
             </layout>
            </widget>
           </item>
          </layout>
         </widget>
        </widget>
       </item>
      </layout>
     </widget>

     <!-- ── Page 1: Configuration ──────────────────────────────────────── -->
     <widget class="QWidget" name="pageConfig">
      <layout class="QVBoxLayout" name="configLayout">
       <item>
        <widget class="QGroupBox" name="instanceGroup">
         <property name="title"><string>Instance</string></property>
         <layout class="QFormLayout" name="instanceForm">
          <item row="0" column="0">
           <widget class="QLabel">
            <property name="text"><string>Name:</string></property>
           </widget>
          </item>
          <item row="0" column="1">
           <widget class="QLineEdit" name="instanceNameEdit">
            <property name="placeholderText"><string>e.g. Nolvus Ascension</string></property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="pathsGroup">
         <property name="title"><string>Paths</string></property>
         <layout class="QFormLayout" name="pathsForm">
          <!-- Instance dir (read-only, derived from name) -->
          <item row="0" column="0">
           <widget class="QLabel">
            <property name="text"><string>Instance folder:</string></property>
           </widget>
          </item>
          <item row="0" column="1">
           <widget class="QLabel" name="instanceDirLabel">
            <property name="text"><string></string></property>
            <property name="styleSheet"><string>color: gray;</string></property>
           </widget>
          </item>
          <!-- Downloads dir -->
          <item row="1" column="0">
           <widget class="QLabel">
            <property name="text"><string>Downloads:</string></property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QWidget" native="true">
            <layout class="QHBoxLayout" name="dlRow">
             <property name="leftMargin"><number>0</number></property>
             <property name="topMargin"><number>0</number></property>
             <property name="rightMargin"><number>0</number></property>
             <property name="bottomMargin"><number>0</number></property>
             <item>
              <widget class="QLineEdit" name="downloadsPathEdit">
               <property name="placeholderText"><string>Where to store downloaded mod archives</string></property>
              </widget>
             </item>
             <item>
              <widget class="QPushButton" name="browseDownloads">
               <property name="text"><string>Browse…</string></property>
              </widget>
             </item>
            </layout>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="optionsGroup">
         <property name="title"><string>Options</string></property>
         <layout class="QVBoxLayout" name="optionsLayout">
          <item>
           <widget class="QCheckBox" name="openAfterCheck">
            <property name="text"><string>Switch to this instance when done</string></property>
            <property name="checked"><bool>true</bool></property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="configNote">
         <property name="text"><string></string></property>
         <property name="wordWrap"><bool>true</bool></property>
         <property name="styleSheet"><string>color: gray; font-style: italic;</string></property>
        </widget>
       </item>
       <item>
        <spacer>
         <property name="orientation"><enum>Qt::Vertical</enum></property>
         <property name="sizeHint" stdset="0">
          <size><width>20</width><height>40</height></size>
         </property>
        </spacer>
       </item>
      </layout>
     </widget>

     <!-- ── Page 2: Progress ──────────────────────────────────────────── -->
     <widget class="QWidget" name="pageProgress">
      <layout class="QVBoxLayout" name="progressLayout">
       <item>
        <widget class="QLabel" name="progressLabel">
         <property name="text"><string>Installing collection…</string></property>
        </widget>
       </item>
       <item>
        <widget class="QProgressBar" name="progressBar">
         <property name="value"><number>0</number></property>
         <property name="textVisible"><bool>true</bool></property>
        </widget>
       </item>
       <item>
        <widget class="QTextEdit" name="logView">
         <property name="readOnly"><bool>true</bool></property>
         <property name="fontFamily"><string>Monospace</string></property>
        </widget>
       </item>
      </layout>
     </widget>

     <!-- ── Page 3: Done ──────────────────────────────────────────────── -->
     <widget class="QWidget" name="pageDone">
      <layout class="QVBoxLayout" name="doneLayout">
       <item>
        <spacer>
         <property name="orientation"><enum>Qt::Vertical</enum></property>
         <property name="sizeHint" stdset="0">
          <size><width>20</width><height>60</height></size>
         </property>
        </spacer>
       </item>
       <item>
        <widget class="QLabel" name="doneLabel">
         <property name="text"><string>Collection installed successfully!</string></property>
         <property name="alignment"><set>Qt::AlignCenter</set></property>
         <property name="styleSheet"><string>font-size: 16px; font-weight: bold;</string></property>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="doneSummary">
         <property name="text"><string></string></property>
         <property name="alignment"><set>Qt::AlignCenter</set></property>
         <property name="wordWrap"><bool>true</bool></property>
        </widget>
       </item>
       <item>
        <spacer>
         <property name="orientation"><enum>Qt::Vertical</enum></property>
         <property name="sizeHint" stdset="0">
          <size><width>20</width><height>60</height></size>
         </property>
        </spacer>
       </item>
      </layout>
     </widget>

    </widget>
   </item>

   <!-- Navigation buttons -->
   <item>
    <widget class="QWidget" name="navWidget" native="true">
     <layout class="QHBoxLayout" name="navLayout">
      <property name="leftMargin"><number>0</number></property>
      <property name="rightMargin"><number>0</number></property>
